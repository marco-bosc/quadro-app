# Copia questo file in .env.local (escluso da git).
# In sviluppo l'app usa SOLO gli emulatori: i valori sotto possono restare fittizi.
# Per il progetto di test reale, i valori si trovano in console Firebase →
# Impostazioni progetto → Le tue app → Configurazione SDK.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=quadro-app-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quadro-app-test
VITE_FIREBASE_STORAGE_BUCKET=quadro-app-test.firebasestorage.app
VITE_FIREBASE_APP_ID=fake-app-id

# "true" = collega l'app agli emulatori (obbligatorio in sviluppo).
VITE_USE_EMULATORS=true
