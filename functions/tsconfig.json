{
  // Compila anche ../shared dentro lib/: il server usa lo stesso modulo di calcolo del frontend.
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src", "../shared"]
}
