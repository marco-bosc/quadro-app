rules_version = '2';

// Ogni dato appartiene a un'azienda. L'accesso passa sempre da memberships/{uid},
// che solo gli script di amministrazione possono scrivere.
//
// Limiti allineati a shared/quote.ts (LIMITS). Le regole non hanno cicli: i campi
// dentro le singole righe di `sections` sono validati dal modulo condiviso prima del
// salvataggio e saranno rivalidati dal server all'emissione (I02b).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function membership() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data;
    }

    function isMember(companyId) {
      return signedIn() && membership().companyId == companyId;
    }

    function isOwner(companyId) {
      return isMember(companyId) && membership().role == 'owner';
    }

    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    function isIntInRange(value, max) {
      return value is int && value >= 0 && value <= max;
    }

    function isVatCode(value) {
      return value in ['VAT22', 'VAT10', 'RC_ATER', 'RC_A', 'FORF'];
    }

    // ---------- Impostazioni dell'azienda ----------
    // Limiti allineati a shared/company.ts (COMPANY_LIMITS) e shared/quote.ts.

    function settingsKeys() {
      return ['taxRegime', 'defaultVatCode', 'hourlyRate', 'defaultValidityText', 'defaultPaymentTermsText', 'version',
              'legalName', 'vatNumber', 'taxCode', 'address', 'phone', 'email', 'website', 'signerName'];
    }

    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(settingsKeys())
        && s.keys().hasAll(settingsKeys())
        && s.taxRegime in ['ordinary', 'flat_rate']
        && isVatCode(s.defaultVatCode)
        && ((s.taxRegime == 'flat_rate') == (s.defaultVatCode == 'FORF'))
        && (s.hourlyRate == null || isIntInRange(s.hourlyRate, 9999999999))
        && isText(s.defaultValidityText, 500)
        && isText(s.defaultPaymentTermsText, 1000)
        && s.version is int
        && isText(s.legalName, 200)
        // Il carattere di controllo della partita IVA è verificato dal client e dal server all'emissione.
        && s.vatNumber is string && s.vatNumber.matches('^([0-9]{11})?$')
        && s.taxCode is string && s.taxCode.matches('^([A-Z0-9]{16}|[0-9]{11})?$')
        && isText(s.address, 300)
        && isText(s.phone, 50)
        && isText(s.email, 200)
        && isText(s.website, 200)
        && isText(s.signerName, 200);
    }

    // Controllo di versione anche sulle impostazioni: si parte da 1, poi +1 a ogni salvataggio.
    function validSettingsVersion() {
      return resource.data.get('settings', null) == null
        ? request.resource.data.settings.version == 1
        : request.resource.data.settings.version == resource.data.settings.version + 1;
    }

    // ---------- Bozza del preventivo ----------

    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'siteAddress', 'contact'])
        && c.keys().hasAll(['name', 'siteAddress', 'contact'])
        && isText(c.name, 200)
        && isText(c.siteAddress, 300)
        && isText(c.contact, 200);
    }

    // Campi del contenuto modificabili dal client finché il preventivo è una bozza.
    function contentKeys() {
      return ['title', 'notes', 'customer', 'validityText', 'paymentTermsText', 'defaultVatCode',
              'finalDiscountCents', 'pdfDetail', 'sections'];
    }

    function baseKeys() {
      return ['status', 'version', 'createdBy', 'createdAt', 'updatedAt'];
    }

    // Una bozza può avere in più solo i riferimenti di revisione, scritti dal server.
    // Numero, istantanea, stato del PDF ecc. esistono solo sui preventivi emessi, che il client non modifica.
    function validQuoteFields(data) {
      return data.keys().hasOnly(contentKeys().concat(baseKeys()).concat(['revisionOf', 'revision']))
        && data.keys().hasAll(contentKeys().concat(baseKeys()))
        && isText(data.title, 200)
        && isText(data.notes, 5000)
        && validCustomer(data.customer)
        && isText(data.validityText, 500)
        && isText(data.paymentTermsText, 1000)
        && isVatCode(data.defaultVatCode)
        && (data.finalDiscountCents == null || isIntInRange(data.finalDiscountCents, 999999999999))
        && data.pdfDetail in ['lines', 'sections', 'total']
        && data.sections is list && data.sections.size() <= 30
        && data.status == 'draft'
        && data.version is int
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create, delete: if false;
      // Il client può modificare solo le impostazioni, e solo il ruolo owner.
      allow update: if isOwner(companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        && validSettings(request.resource.data.settings)
        && validSettingsVersion();

      match /quotes/{quoteId} {
        allow read: if isMember(companyId);

        // Il client crea solo bozze nuove, senza campi riservati al server.
        allow create: if isMember(companyId)
          && validQuoteFields(request.resource.data)
          && request.resource.data.keys().hasOnly(contentKeys().concat(baseKeys()))
          && request.resource.data.version == 1
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Solo le bozze si modificano, e solo nel contenuto. Stato, autore, date di creazione,
        // riferimenti di revisione restano invariati; emessi e sostituiti sono in sola lettura.
        // Controllo di versione anche lato server: ogni salvataggio parte dalla versione attuale.
        allow update: if isMember(companyId)
          && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(contentKeys().concat(['version', 'updatedAt']))
          && validQuoteFields(request.resource.data)
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // Contatori della numerazione: leggibili per mostrare il prossimo numero, scritti solo dal server.
      match /counters/{counterId} {
        allow read: if isMember(companyId);
        allow write: if false;
      }
    }
  }
}
